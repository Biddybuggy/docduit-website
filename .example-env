# Public (safe to expose in client bundle)
NEXT_PUBLIC_ENV=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=
NEXT_PUBLIC_CHAT_DEMO_MODE=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only secrets (never use NEXT_PUBLIC_ prefix)
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
OPENAI_API_KEY=
OPENAI_INVOICE_MODEL=gpt-4o-mini
# Optional. Model for the Financial Twin Simulator AI narrative.
# Falls back to OPENAI_INVOICE_MODEL, then gpt-4o-mini.
OPENAI_TWIN_MODEL=gpt-4o-mini
AI_CHAT_URL=
CHAT_DEMO_CF_WORKER_URL=

# Email (invoice reminders). Gmail SMTP for now — swappable to Resend/SES later.
# SMTP_USER: your full Gmail address.
# SMTP_APP_PASSWORD: a 16-char Google App Password (NOT your Gmail login password).
#   Requires 2-Step Verification enabled, then create one at
#   https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=Docduit
# Optional overrides (defaults shown). Use 587 if 465 is blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Where "Report a bug" submissions are emailed. Falls back to SMTP_USER if unset.
BUG_REPORT_TO=

# Deprecated: do not use NEXT_PUBLIC_AI_CHAT_URL or NEXT_PUBLIC_GOOGLE_CLIENT_SECRET.
# AI requests are proxied through /api/chat/* routes using AI_CHAT_URL server-side.
